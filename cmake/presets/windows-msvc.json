{
  "version": 3,
  "configurePresets": [
    {
      "name": "windows-msvc",
      "displayName": "Windows MSVC",
      "description": "Visual Studio + Ninja build with SDL2/TTF injected via vcpkg/choco.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_WINDOWS_EXPORT_ALL_SYMBOLS": "ON",
        "BUILD_LIBHYDRA": "ON",
        "BUILD_POSIX_TOOLS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows",
      "displayName": "Windows Build",
      "configurePreset": "windows-msvc"
    }
  ]
}
